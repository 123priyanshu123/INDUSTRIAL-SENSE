# Path to locally available KAIST rotating-machine dataset root (Google Drive for Desktop mount or local folder)
KAIST_DATA_ROOT=

# Backend host/port
APP_HOST=127.0.0.1
APP_PORT=8000

# Optional: specific .mat file to load (relative path from KAIST_DATA_ROOT) for the first vertical slice
# KAIST_SELECTED_FILE=subdir/example.mat

# Optional: comma-separated relative paths (from KAIST_DATA_ROOT) treated as verified healthy baseline recordings
# If empty/unset, backend will not train an anomaly detector and will report anomaly detection as unavailable.
KAIST_HEALTHY_BASELINE_FILES=

# Optional: max number of recordings to load/process (default 1 for first vertical slice)
KAIST_MAX_RECORDINGS=1

# Processed feature cache directory (relative to backend/)
CACHE_DIR=cache
